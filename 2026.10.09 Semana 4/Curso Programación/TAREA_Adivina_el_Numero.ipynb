# Escriba aquí su juego Adivina el número.
import random

print("===ADIVINA EL NÚMERO: FRÍO O CALIENTE===")
secreto = random.randint(1 , 20)
intentos = 0

while True:
  intento = int(input("Escriba un número del 1 al 20: "))
  intentos = intentos + 1

  distancia = abs(secreto - intento)

  if intento == secreto:
    print(f"Correcto. Adivinó en {intentos} intentos. ")
    break
  elif intento < secreto:
    print("El número secreto es mayor. ")
  else:
    print("El número secreto es menor. ")

  
  if distancia <= 2:
    print("Hirviendo: está casi encima del número. ")
  elif distancia <= 5:
    print("Caliente: está cerca. ")
  elif distancia <= 10:
    print("Tibio: va por buen camino, pero falta. ")
  else:
    print("Frio: está lejos. ")